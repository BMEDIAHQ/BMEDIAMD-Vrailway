# Server (Railway supplies PORT automatically at runtime)
PORT=3000

# WhatsApp session generated by BMEDIA-MASTER pairing
SESSION_ID=

# Bot identity / behavior
PREFIX=!
BOT_MODE=public
PHONE_NUMBER=
OWNER_NUMBER=
BOT_OWNER=
SUDO_NUMBERS=
TIMEZONE=Africa/Douala
STATUS_REACT_EMOJIS=
AUTOREACT_EMOJIS=
ALLOW_SELF=0
AUTO_RELOAD_COMMANDS=0
COMMAND_TIMEOUT_MS=15000
REACT_COOLDOWN_MS=

# Branding / links
CHANNEL_URL=
CHANNEL_NAME=
REPO_URL=
REPO_NAME=
BOT_NAME=BMEDIA-MD
AUTHOR=BMEDIA

# Misc existing bot options
TTS_LANG=en
TTS_SLOW=0
KICKBATCH_MAX_PER_RUN=
STATUS_VIEW_DEBUG=
REPO_BRANCH=main
REPO_ENTRY=index.js
BOOTSTRAP_CLEAN_ROOT=

# MongoDB session persistence
MONGODB_URI=
SESSION_DB_NAME=bmedia_sessions
SESSION_COLLECTION=sessions
SESSION_SYNC_DEBOUNCE_MS=1500

# Optional APIs already used by commands
CLOUDFLARE_AI_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Existing optional integrations
GROQ_API_KEY=
GROQ_MODEL=
STARTUP_GROUP_LINK=
